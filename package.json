{
  "name": "sigr",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx scripts/migrar.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrar.ts --reset && tsx scripts/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verificar": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "setup": "npm run db:migrate && npm run db:seed",
    "e2e:servidor": "npm run e2e:bd && next build && next start",
    "auditoria": "npm audit --omit=dev && npm audit --audit-level=high",
    "e2e:bd": "tsx scripts/migrar.ts --reset && tsx scripts/seed.ts",
    "build:scripts": "esbuild scripts/migrar.ts scripts/seed.ts --bundle --platform=node --format=cjs --target=node20 --packages=external --outdir=dist/scripts",
    "test:carga": "k6 run tests/carga/staging.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "SIGR - Sistema Integral de Gestión de Restaurante (línea base)",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
