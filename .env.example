# Copiar a .env y ajustar.
# Ruta del archivo SQLite (relativa a la raíz del proyecto).
DATABASE_URL="file:./data/sigr.db"
# Clave para firmar la cookie de sesión (mínimo 32 caracteres).
SESSION_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria-123456"

# --- Opcionales ---
# Datos del restaurante que aparecen como emisor en las facturas (valores ficticios por defecto).
# RESTAURANTE_RAZON_SOCIAL="SIGR Restaurante Académico S.A.S."
# RESTAURANTE_NIT="900.000.000-0"
# RESTAURANTE_DIRECCION="Calle de ejemplo # 00-00, Bucaramanga, Santander"
# RESTAURANTE_TELEFONO="+57 607 000 0000"
# Canal de eventos de pedidos (milisegundos).
# SSE_LATIDO_MS=15000          # latido y reverificación de sesión/rol
# SSE_DURACION_MAX_MS=600000   # renovación periódica de la conexión
# SSE_REINTENTO_MS=2000        # espera sugerida al navegador antes de reconectar
